# Solana — Public Alpha runs on Devnet only.
# Single canonical mint address for all LFG + utility/boost operations.
# Canonical devnet mint: ByrXMnACFFyvsL6d4yKFguCK8CNRJDMSWWshLejaApVu
VITE_LIFETOPIA_ALPHA_MINT=ByrXMnACFFyvsL6d4yKFguCK8CNRJDMSWWshLejaApVu
VITE_TOKEN_MINT_ADDRESS=ByrXMnACFFyvsL6d4yKFguCK8CNRJDMSWWshLejaApVu
VITE_ALPHA_NFT_MINT=
VITE_DEVNET_TOKEN_MINT=ByrXMnACFFyvsL6d4yKFguCK8CNRJDMSWWshLejaApVu
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# OPTIONAL (server-side only) — devnet treasury JSON key array used to mint LFG to
# players from the browser. DO NOT commit a real key. Leave empty for WDK-only mode.
VITE_LFG_TREASURY_KEY=

# Wallet deep-link (REQUIRED for mobile wallet connect on HTTPS deployment)
# Set this to your deployed URL, e.g. https://lifetopia-app.up.railway.app
VITE_WALLET_DAPP_URL=https://your-app.railway.app
