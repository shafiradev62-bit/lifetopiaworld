# Solana — Public Alpha runs on Devnet only.
# Single canonical mint address for all LFG + utility/boost operations.
# Canonical devnet mint: ByrXMnACFFyvsL6d4yKFguCK8CNRJDMSWWshLejaApVu
VITE_LIFETOPIA_ALPHA_MINT=ByrXMnACFFyvsL6d4yKFguCK8CNRJDMSWWshLejaApVu
VITE_TOKEN_MINT_ADDRESS=ByrXMnACFFyvsL6d4yKFguCK8CNRJDMSWWshLejaApVu
VITE_ALPHA_NFT_MINT=
VITE_DEVNET_TOKEN_MINT=ByrXMnACFFyvsL6d4yKFguCK8CNRJDMSWWshLejaApVu
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# OPTIONAL — USDt devnet mint override. Defaults to the canonical devnet USDt
# mint (classic SPL, 6 decimals). On mainnet, set this to Tether's official
# USDt mint: Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
VITE_DEVNET_USDT_MINT=EJwZgeZrdC8TXTQbQBoL6bfuAnFUUy1PVCMB4DYPzVaS

# WDK MULTICHAIN — EVM wallet derived from the same seed (Sepolia by default).
# Override the RPC/chain for any EVM network; USDt is the reference Sepolia
# deployment (6 decimals).
VITE_EVM_RPC_URL=https://ethereum-sepolia.publicnode.com
VITE_EVM_CHAIN_ID=11155111
VITE_SEPOLIA_USDT=0xd077a400968890eacc75cdc901f0356c943e4fdb

# WDK GASLESS — Kora-compatible paymaster (sponsors Solana fees, charged in
# USDt). Leave empty to run without the gasless wallet; the game degrades
# gracefully. See the WDK gasless guide for hosted (Candide) or self-hosted
# Kora paymaster setup.
VITE_SOLANA_PAYMASTER_URL=
VITE_SOLANA_PAYMASTER_ADDRESS=
VITE_SOLANA_PAYMASTER_TOKEN=EJwZgeZrdC8TXTQbQBoL6bfuAnFUUy1PVCMB4DYPzVaS

# OPTIONAL (server-side only) — devnet treasury JSON key array used to mint LFG to
# players from the browser. DO NOT commit a real key. Leave empty for WDK-only mode.
VITE_LFG_TREASURY_KEY=

# Wallet deep-link (REQUIRED for mobile wallet connect on HTTPS deployment)
# Set this to your deployed URL, e.g. https://lifetopia-app.up.railway.app
VITE_WALLET_DAPP_URL=https://your-app.railway.app
