{
  "name": "@workspace/farming-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "build:capacitor": "node scripts/capacitor-vite-build.mjs",
    "cap:sync": "npx cap sync android",
    "cap:build": "npm run build:capacitor && npx cap sync android",
    "cap:apk": "npm run build:capacitor && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^29.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@noble/ed25519": "3.1.0",
    "@noble/hashes": "2.2.0",
    "@solana/kit": "3.0.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tetherto/wdk": "^1.0.0-beta.16",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.16",
    "@tetherto/wdk-wallet-solana": "^1.0.0-beta.12",
    "@tetherto/wdk-wallet-solana-gasless": "1.0.0-beta.1",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "sodium-javascript": "~0.8.0"
  }
}
